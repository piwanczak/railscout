# Official PKP PLK timetable API. Register and accept the provider's terms first.
PLK_API_KEY=

# Optional compatible GRM root; defaults to Intercity's official seat-map API.
EIC_GRM_API_URL=

# Shared bearer token when EIC_GRM_API_URL points to the first-party relay.
EIC_GRM_API_TOKEN=

# Optional upstream safety tuning; defaults are 4000 ms and 350 ms.
EIC_GRM_REQUEST_TIMEOUT_MS=
EIC_GRM_MIN_INTERVAL_MS=

# Optional e-IC client contract override; defaults to the tested production version.
EIC_APP_VERSION=

# Required by the standalone first-party relay; use at least 32 random characters.
RAILSCOUT_RELAY_TOKEN=
