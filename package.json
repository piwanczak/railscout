{
  "name": "railscout",
  "version": "0.1.0",
  "description": "Independent PKP Intercity timetable and exact seat-availability explorer.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piwanczak/railscout.git"
  },
  "bugs": {
    "url": "https://github.com/piwanczak/railscout/issues"
  },
  "homepage": "https://github.com/piwanczak/railscout#readme",
  "keywords": [
    "pkp",
    "rail",
    "seat-availability",
    "poland"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/preview-server.mjs",
    "preview": "npm run build && npm run start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/gtfs-refresh.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern app/data",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run data:check && npm run licenses:check",
    "data:import": "node scripts/import-open-gtfs.mjs",
    "data:refresh": "node scripts/refresh-open-gtfs.mjs",
    "data:check": "node scripts/check-data-provenance.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "fflate": "0.8.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  },
  "type": "module"
}
