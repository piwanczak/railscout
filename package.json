{
  "name": "railscout",
  "version": "0.1.0",
  "description": "Independent PKP Intercity timetable and exact seat-availability explorer.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piwanczak/railscout.git"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/preview-server.mjs",
    "preview": "npm run build && npm run start",
    "relay:start": "node scripts/grm-relay.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/gtfs-refresh.test.mjs tests/grm-relay.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run data:check && npm run licenses:check",
    "data:import": "node scripts/import-open-gtfs.mjs",
    "data:refresh": "node scripts/refresh-open-gtfs.mjs",
    "data:check": "node scripts/check-data-provenance.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.33",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fflate": "0.8.3",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "wrangler": "4.119.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  },
  "type": "module"
}
