{
  "name": "railscout",
  "version": "0.1.0",
  "description": "Independent PKP Intercity timetable and exact seat-availability explorer.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piwanczak/railscout.git"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/preview-server.mjs",
    "preview": "npm run build && npm run start",
    "relay:start": "node scripts/grm-relay.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm test && npm run data:check && npm run licenses:check",
    "data:import": "node scripts/import-open-gtfs.mjs",
    "data:refresh": "node scripts/refresh-open-gtfs.mjs",
    "data:check": "node scripts/check-data-provenance.mjs",
    "test:browser": "playwright test",
    "monitor:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fflate": "0.8.3",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.2",
    "undici": "7.29.1"
  },
  "type": "module"
}
